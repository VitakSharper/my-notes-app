################################################################################
# Originally generated by Visual Studio as one entry per project/configuration,
# which let bin/Release/net10.0 through as soon as a project was published
# without a RID. Replaced by the conventional .NET rules below.
################################################################################

# build output
[Bb]in/
[Oo]bj/

# IDE
/.vs
/.idea

# aspire publish/deploy output (generated, and .env holds the parameter values)
/Overflow.AppHost/aspire-output/

# local env files
.env.local
