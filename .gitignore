################################################################################
# Originally generated by Visual Studio as one entry per project/configuration,
# which let bin/Release/net10.0 through as soon as a project was published
# without a RID. Replaced by the conventional .NET rules below.
################################################################################

# build output
[Bb]in/
[Oo]bj/

# IDE
/.vs
/.idea

# aspire publish/deploy output (generated, and .env holds the parameter values)
/Overflow.AppHost/aspire-output/

# local env files
.env.local

# generated compose env: holds the container passwords in clear text
/Overflow.AppHost/infra/.env
/Overflow.AppHost/infra/.env.Production

# npm never belongs at the repo root: the client app has its own package.json
/node_modules/
/package.json
/package-lock.json

# mkcert output: a private key, and every developer issues their own from their own local CA
/Overflow.AppHost/infra/dev-certs/
